# ====================================================================
# Singularity Student Lab - Production Environment Variables
# ====================================================================

# 1. Primary PostgreSQL Connection String (Transaction Pooler - port 6543)
# Example for Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://postgres:password@localhost:5432/singularity_lab?schema=public"

# 2. Direct PostgreSQL Connection String (Session / Direct - port 5432)
# Used for Prisma schema pushes / migrations:
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/singularity_lab?schema=public"

# 3. Supabase Project Configuration (Optional client access)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"

# 4. Cryptographic JWT Secret for Session Signing (HS256)
# MUST be set in production and at least 32 characters long.
# Generate in terminal: openssl rand -hex 32
JWT_SECRET="e9c7a2b5d4f180369a4e8d2c7f1b5a9e3d8c2b7f1a4e9d2c7f1b5a9e3d8c2b7f"

# Optional fallback captcha secret (defaults to JWT_SECRET if unset, min 32 chars)
CAPTCHA_SECRET=""

# 5. Public Application Canonical URL (used for metadata, OpenGraph, sitemap)
NEXT_PUBLIC_APP_URL="https://singularity.space.edu.in"

# 6. Vercel Blob Storage (Option A: Permanent Cloud File Storage)
# Obtain from Vercel Project Dashboard -> Storage -> Blob -> Create Database
# In local dev: run `npx vercel env pull .env.local` to sync your blob token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# 7. Upstash Redis (Option A: Distributed Serverless Rate Limiting)
# Obtain from Upstash Console (https://console.upstash.com) or Vercel Marketplace -> Upstash Redis
UPSTASH_REDIS_REST_URL="https://xxxx-xxxx-00000.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AxxxxxxAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="
# (Alternative Vercel KV aliases also supported: KV_REST_API_URL and KV_REST_API_TOKEN)

# 8. Cloudflare Turnstile (Option A: Modern Invisible/Interactive Bot Protection)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Widget (Domain: your domain or localhost)
# Dummy development test keys that always pass:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
